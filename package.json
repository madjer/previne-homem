{
  "name": "previne-homem",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "deploy": "npm run build:prod && firebase deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "20.3.x",
    "@angular/compiler": "20.3.x",
    "@angular/core": "20.3.x",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "20.3.x",
    "@angular/platform-browser": "20.3.x",
    "@angular/router": "20.3.x ",
    "@angular/service-worker": "20.3.x",
    "firebase": "^10.12.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.x",
    "@angular/cli": "20.3.x",
    "@angular/compiler-cli": "20.3.x",
    "autoprefixer": "^10.4.19",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
